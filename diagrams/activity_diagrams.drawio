ell><mxCell id="p4_d10" value="Is the forecast at or above 75% of the average?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontSize=11;fontColor=#78350f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="3622" width="260" height="110" as="geometry" /></mxCell><mxCell id="p4_o_med" value="Mark the day as a medium-demand day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=11;fontColor=#7f1d1d;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="3650" width="280" height="54" as="geometry" /></mxCell><mxCell id="p4_o_low" value="Mark the day as a low-demand day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;fontColor=#14532d;arcSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="3776" width="340" height="54" as="geometry" /></mxCell><mxCell id="p4_peak" value="Show the day with the highest expected demand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;fontSize=12;fontColor=#14532d;arcSize=12;" vertex="1" parent="1"><mxGeometry x="390" y="3874" width="340" height="54" as="geometry" /></mxCell><mxCell id="p4_logout" value="Log out of the system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0369a1;fontSize=12;fontColor=#0c4a6e;arcSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="3972" width="300" height="54" as="geometry" /></mxCell><mxCell id="p4_end" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#052e16;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="542" y="4070" width="36" height="36" as="geometry" /></mxCell><mxCell id="p4_final_in" value="" style="ellipse;html=1;fillColor=#052e16;strokeColor=none;" vertex="1" parent="p4_end"><mxGeometry x="12" y="12" width="12" height="12" as="geometry" /></mxCell><mxCell id="p4_tagS" value="Start" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#47556