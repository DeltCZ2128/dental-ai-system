l the administrator that the slot is not free" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;fontSize=11;fontColor=#7f1d1d;arcSize=12;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="800" y="1256" width="280" height="54" as="geometry" /></mxCell><mxCell id="p3_save" value="Save the appointment with status Pending" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0369a1;fontSize=12;fontColor=#0c4a6e;arcSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="1382" width="300" height="54" as="geometry" /></mxCell><mxCell id="p3_d5" value="Change the appointment status?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontSize=11;fontColor=#78350f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="1480" width="260" height="110" as="geometry" /></mxCell><mxCell id="p3_status" value="Set the appointment to Confirmed, Completed or Cancelled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0369a1;fontSize=12;fontColor=#0c4a6e;arcSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="1634" width="300" height="54" as="geometry" /></mxCell><mxCell id="p3_d6" value="Send an appointment reminder?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontSize=11;fontColor=#78350f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="1732" width="260" height="110" as="geometry" /></mxCell><mxCell id="p3_remind" value="Send the appointment reminder to the patient by e-mail" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0f2fe;strokeColor=#0369a1;fontSize=12;fontColor=#0c4a6e;arcSize=12;" vertex="1" parent="1"><mxGeometry x="0" y="1886" width="300" height="54" as="geometry" /></mxCell><mxCell id="p3_d7" value="Reschedule an appointment?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;fontSize=11;fontColor=#78350f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="430" y="1984" width="260" height="1